# ── Baza ──────────────────────────────────────────────────────────────────────
# Lokalno (npm run db:start):
DATABASE_URL=postgres://postgres:postgres@localhost:54329/rokovnik
# Supabase: Project Settings → Database → Connection string
#   DATABASE_URL i DIRECT_URL = "Session pooler" (port 5432)
#   NE koristiti "Transaction pooler" (port 6543) — gubi upise u transakcijama.
# DATABASE_URL=postgresql://postgres.xxxx:LOZINKA@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# DIRECT_URL=postgresql://postgres.xxxx:LOZINKA@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DIRECT_URL=
# Generisati: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3100
NEXT_PUBLIC_APP_URL=http://localhost:3100
# ── AI recepcioner ────────────────────────────────────────────────────────────
# platform.openai.com → API keys (preporuka: poseban ključ samo za ovaj projekat)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# ── Praćenje grešaka (Sentry, nije obavezno) ─────────────────────────────────
# sentry.io → novi projekat (Next.js) → Settings → Client Keys (DSN)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Za čitljive tragove grešaka (source maps) na Vercelu:
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── Admin platforme ──────────────────────────────────────────────────────────
# Emailovi (odvojeni zarezom) koji vide /admin/prijave — prijave salona za pilot
ADMIN_EMAILS=

# ── Email obavijesti (Resend, nije obavezno) ─────────────────────────────────
# resend.com → API Keys. Bez vlastitog domena šalje se samo na email Resend naloga.
RESEND_API_KEY=
# Kad verifikujete domen: EMAIL_FROM="Rokovnik <obavijesti@vasdomen.ba>"
EMAIL_FROM=
